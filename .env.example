# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# litellm reads this whole file (env_file); model-sync only gets the explicit
# key list in docker-compose.yml.

# ── Gateway ─────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-change-me
STORE_MODEL_IN_DB=True
UI_USERNAME=admin
UI_PASSWORD=change-me

# ── Database (litellm-db) ───────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:change-me@db:5432/litellm

# ── Provider keys ───────────────────────────────────────────────
# Each name is a `credential:` in freerouter/providers/*.yaml; a provider whose
# key is empty is skipped. See freerouter/.env.example for where to get each one.
AION_LABS_API_KEY=
APINEX_API_KEY=
CEREBRAS_API_KEY=
CLEANAPIS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
ELECTRONHUB_API_KEY=
EVREN_API_KEY=
EXPLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLMTR_API_KEY=
MISTRAL_API_KEY=
MODELSCOPE_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
SAMBANOVA_API_KEY=
TIARINA_API_KEY=
TOKENHARBOR_API_KEY=
ZENMUX_API_KEY=
# Bridged by docker-compose.yml: ZHIPU_API_KEY=${ZAI_API_KEY}, HUGGINGFACE_API_KEY=${HF_TOKEN}
ZAI_API_KEY=
HF_TOKEN=

# Keyless tiers: any non-empty placeholder keeps the provider from being skipped.
KILO_API_KEY=unused
LLM7_API_KEY=unused

# ── Notifications (check_new_providers.py) ──────────────────────
N8N_NOTIFY_WEBHOOK_URL=
